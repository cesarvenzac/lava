{
  "name": "@cesarvenzac/lava",
  "version": "1.0.0",
  "description": "A lava lamp for any box, simulated: thousands of particles of wax in 3D rising, pressing together and sinking back at a real lamp's speeds, glowing in a dark liquid, shot through a long lens with a shallow focus, bloom and a filmic grade. WebGL 2 and a worker, no dependencies.",
  "keywords": [
    "lava",
    "lava-lamp",
    "simulation",
    "sph",
    "fluid",
    "blobs",
    "ray-marching",
    "depth-of-field",
    "bloom",
    "background",
    "shader",
    "webgl",
    "webgl2",
    "react"
  ],
  "homepage": "https://cesarvenzac.com/lava",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesarvenzac/lava.git"
  },
  "bugs": "https://github.com/cesarvenzac/lava/issues",
  "author": "César Venzac (https://cesarvenzac.com)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "sh check/run.sh",
    "worker": "node scripts/worker.mjs",
    "warm": "node --no-warnings scripts/warm.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
